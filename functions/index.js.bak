    });
});

export const ejecutarComandoBasico = onRequest({ cors: true, timeoutSeconds: 60, memory: '256MiB' }, async (req, res) => {
    if (req.method === 'OPTIONS') {
        res.status(204).send('');
        return;
    }

    if (req.method !== 'POST') {
        res.status(405).json({ error: 'Método no permitido' });
        return;
    }

    try {
        const { comando, idioma = 'es' } = req.body;
        const userId = req.headers.authorization || 'anonymous';
        
        if (!comando || comando.trim() === '') {
            res.status(400).json({ respuesta: 'Escribe un comando válido.' });
            return;
        }
        
        const texto = comando.toLowerCase();
        
        if (texto.includes('registra:') || (texto.includes('compra') && !texto.includes('venta'))) {
            
            let cantidad = 1;
            let valorTotal = 0;
            let producto = 'Producto';
            let proveedor = '';
            let esCredito = texto.includes('credito') || texto.includes('crédito') || texto.includes('fiado');
            
            const cantidadMatch = comando.match(/(\d+)\s*(?:unidades?|pares?|items?|productos?)/i);
            if (cantidadMatch) cantidad = parseInt(cantidadMatch[1]);
            
            const valorMatch = comando.match(/(?:por|total|valor)\s*[\$]?\s*([\d.,]+)/i);
            if (valorMatch) valorTotal = limpiarNumero(valorMatch[1]);
            
            if (!valorTotal) {
                const numeros = comando.match(/[\d.,]+/g);
                if (numeros) {
                    const valores = numeros.map(n => limpiarNumero(n));
                    valorTotal = Math.max(...valores);
                }
            }
            
            const productMatch = comando.match(/(?:de|para)\s+(\d+\s+)?([a-záéíóúñ\s]{3,30}?)(?:\s+(?:a|por|con|para|credito|efectivo|$))/i);
            if (productMatch && productMatch[2]) producto = productMatch[2].trim();
            
            const provMatch = comando.match(/(?:se le debe a|proveedor|a)\s+([a-záéíóúñ\s]{3,30}?)(?:\s+(?:por|para|$))/i);
            if (provMatch) proveedor = provMatch[1].trim();
            
            if (!valorTotal || valorTotal <= 0) {
                res.json({ respuesta: ' No entendí el valor de la compra. Ejemplo: "registra: compra de 10 zapatos por 550000"' });
                return;
            }
            
            const precioUnitario = valorTotal / cantidad;
            const estado = esCredito ? 'PENDIENTE' : 'PAGADO';
            
            const movimiento = {
                userId,
                tipo: 'egreso',
                categoria: 'INVENTARIO',
                concepto: producto,
                cantidad,
                valor: valorTotal,
                precioUnitario: Math.round(precioUnitario * 100) / 100,
                proveedor: proveedor || 'No especificado',
                estado,
                fecha: new Date().toISOString(),
                fechaCreacion: new Date().toISOString()
            };
            
            await db.collection('movimientos').add(movimiento);
            
            const inventarioRef = db.collection('inventario');
            const q = await inventarioRef.where('userId', '==', userId).where('producto', '==', producto).get();
            
            if (q.empty) {
                await inventarioRef.add({
                    userId,
                    producto,
                    cantidad,
                    costoUnitario: Math.round(precioUnitario * 100) / 100,
                    fechaActualizacion: new Date().toISOString()
                });
            } else {
                const doc = q.docs[0];
                const data = doc.data();
                const nuevaCantidad = (data.cantidad || 0) + cantidad;
                const nuevoCosto = ((data.cantidad || 0) * (data.costoUnitario || 0) + (cantidad * precioUnitario)) / nuevaCantidad;
                await doc.ref.update({
                    cantidad: nuevaCantidad,
                    costoUnitario: Math.round(nuevoCosto * 100) / 100,
                    fechaActualizacion: new Date().toISOString()
                });
            }
            
            let respuesta = ` **COMPRA REGISTRADA**\n`;
            respuesta += ` ${cantidad} ${producto}\n`;
            respuesta += ` Total: ${formatearMoneda(valorTotal)}\n`;
            respuesta += ` Unitario: ${formatearMoneda(precioUnitario)}\n`;
            respuesta += ` Proveedor: ${proveedor || 'No especificado'}\n`;
            respuesta += ` Estado: ${estado}`;
            
            res.json({ respuesta });
            return;
        }
        
        if (texto.includes('venta:') || texto.includes('vendí') || texto.includes('vendi')) {
            
            let cantidad = 1;
            let valorTotal = 0;
            let producto = 'Producto';
            let cliente = '';
            let esCredito = texto.includes('credito') || texto.includes('crédito') || texto.includes('fiado');
            
            const cantidadMatch = comando.match(/(\d+)\s*(?:unidades?|pares?|items?)/i);
            if (cantidadMatch) cantidad = parseInt(cantidadMatch[1]);
            
            const valorMatch = comando.match(/(?:a|por)\s*[\$]?\s*([\d.,]+)/i);
            if (valorMatch) valorTotal = limpiarNumero(valorMatch[1]);
            
            if (!valorTotal) {
                const numeros = comando.match(/[\d.,]+/g);
                if (numeros) {
                    const valores = numeros.map(n => limpiarNumero(n));
                    valorTotal = Math.max(...valores);
                }
            }
            
            const productMatch = comando.match(/(?:de|venta|vend[ií])\s+(\d+\s+)?([a-záéíóúñ\s]{3,30}?)(?:\s+(?:a|por|para|$))/i);
            if (productMatch && productMatch[2]) producto = productMatch[2].trim();
            
            const clientMatch = comando.match(/(?:a|cliente|para)\s+([a-záéíóúñ\s]{3,30}?)(?:\s+(?:por|$))/i);
            if (clientMatch) cliente = clientMatch[1].trim();
            
            if (!valorTotal || valorTotal <= 0) {
                res.json({ respuesta: ' No entendí el valor de la venta. Ejemplo: "venta: 3 camisas a 60 mil"' });
                return;
            }
            
            const inventarioRef = db.collection('inventario');
            const q = await inventarioRef.where('userId', '==', userId).where('producto', '==', producto).get();
            let costoUnitario = 0;
            
            if (!q.empty) {
                costoUnitario = q.docs[0].data().costoUnitario || 0;
                const data = q.docs[0].data();
                const nuevaCantidad = (data.cantidad || 0) - cantidad;
                await q.docs[0].ref.update({ cantidad: Math.max(0, nuevaCantidad) });
            }
            
            const precioUnitario = valorTotal / cantidad;
            const costoTotal = costoUnitario * cantidad;
            const ganancia = valorTotal - costoTotal;
            const margen = valorTotal > 0 ? (ganancia / valorTotal) * 100 : 0;
            
            const movimiento = {
                userId,
                tipo: 'ingreso',
                categoria: 'VENTA',
                concepto: producto,
                cantidad,
                valor: valorTotal,
                precioUnitario: Math.round(precioUnitario * 100) / 100,
                costoUnitario: Math.round(costoUnitario * 100) / 100,
                costoTotal: Math.round(costoTotal * 100) / 100,
                ganancia: Math.round(ganancia * 100) / 100,
                margen: Math.round(margen * 10) / 10,
                cliente: cliente || 'Cliente general',
                estado: esCredito ? 'PENDIENTE' : 'PAGADO',
                fecha: new Date().toISOString(),
                fechaCreacion: new Date().toISOString()
            };
            
            await db.collection('movimientos').add(movimiento);
            
            let respuesta = ` **VENTA REGISTRADA**\n`;
            respuesta += ` ${cantidad} ${producto}\n`;
            respuesta += ` Total: ${formatearMoneda(valorTotal)}\n`;
            respuesta += ` Unitario: ${formatearMoneda(precioUnitario)}\n`;
            respuesta += ` Costo unitario: ${formatearMoneda(costoUnitario)}\n`;
            respuesta += ` Ganancia: ${formatearMoneda(ganancia)} (${margen.toFixed(1)}%)\n`;
            respuesta += ` Cliente: ${cliente || 'Cliente general'}\n`;
            respuesta += ` Estado: ${esCredito ? 'PENDIENTE' : 'PAGADO'}`;
            
            res.json({ respuesta });
            return;
        }
        
        if (texto.includes('informe') || texto.includes('presenta:')) {
            
            const esInformeCompleto = texto.includes('completo') || texto.includes('full');
            
            if (esInformeCompleto) {
                let plan = 'starter';
                try {
                    const userDoc = await db.collection('usuarios').doc(userId).get();
                    if (userDoc.exists) plan = userDoc.data().plan || 'starter';
                } catch (e) { logger.error(e); }
                
                const resultado = await generarReporteCompleto(userId, idioma, plan);
                
                if (resultado.error) {
                    res.json({ respuesta: resultado.mensaje });
                    return;
                }
                
                let respuesta = ` **INFORME FINANCIERO COMPLETO**\n`;
                respuesta += `━━━━━━━━━━━━━━━━━━━━━━\n\n`;
                respuesta += ` Ventas: ${formatearMoneda(resultado.datos.ventas_totales)}\n`;
                respuesta += ` Compras: ${formatearMoneda(resultado.datos.costo_ventas)}\n`;
                respuesta += ` Gastos: ${formatearMoneda(resultado.datos.gastos_operativos)}\n`;
                respuesta += ` Utilidad: ${formatearMoneda(resultado.datos.utilidad_neta)}\n`;
                respuesta += ` Margen: ${resultado.datos.margen_neto.toFixed(1)}%\n\n`;
                
                respuesta += ` **FLUJO DE CAJA**\n`;
                respuesta += ` Ingresos operativos: ${formatearMoneda(resultado.datos.flujo_caja.ingresos_operativos)}\n`;
                respuesta += ` Egresos operativos: ${formatearMoneda(resultado.datos.flujo_caja.egresos_operativos)}\n`;
                respuesta += ` Flujo operativo: ${formatearMoneda(resultado.datos.flujo_caja.flujo_operativo)}\n`;
                respuesta += ` Saldo final: ${formatearMoneda(resultado.datos.flujo_caja.saldo_final)}\n`;
                
                res.json({ respuesta, pdfBuffer: resultado.pdfBuffer });
                return;
            }
            
            const movimientosRef = db.collection('movimientos');
            const snapshot = await movimientosRef.where('userId', '==', userId).orderBy('fecha', 'desc').limit(500).get();
            
            const movimientos = snapshot.docs.map(doc => doc.data());
            const ventas = movimientos.filter(m => m.tipo === 'ingreso');
            const compras = movimientos.filter(m => m.tipo === 'egreso' && m.categoria === 'INVENTARIO');
            const gastos = movimientos.filter(m => m.tipo === 'egreso' && m.categoria !== 'INVENTARIO');
            
            const totalVentas = ventas.reduce((s, m) => s + (m.valor || 0), 0);
            const totalCompras = compras.reduce((s, m) => s + (m.valor || 0), 0);
            const totalGastos = gastos.reduce((s, m) => s + (m.valor || 0), 0);
            const utilidad = totalVentas - totalCompras - totalGastos;
            const margen = totalVentas > 0 ? (utilidad / totalVentas) * 100 : 0;
            
            let respuesta = ` **INFORME FINANCIERO**\n`;
            respuesta += `━━━━━━━━━━━━━━━━━━━━━━\n\n`;
            respuesta += ` Ventas: ${formatearMoneda(totalVentas)}\n`;
            respuesta += ` Compras: ${formatearMoneda(totalCompras)}\n`;
            respuesta += ` Gastos: ${formatearMoneda(totalGastos)}\n`;
            respuesta += ` Utilidad: ${formatearMoneda(utilidad)}\n`;
            respuesta += ` Margen: ${margen.toFixed(1)}%\n\n`;
            
            respuesta += ` **ÚLTIMOS MOVIMIENTOS**\n`;
            movimientos.slice(0, 5).forEach(m => {
                const signo = m.tipo === 'ingreso' ? '+' : '-';
                respuesta += ` ${m.concepto}: ${signo} ${formatearMoneda(m.valor || 0)}\n`;
            });
            
            res.json({ respuesta });
            return;
        }
        
        res.json({ 
            respuesta: ` **Comandos disponibles:**\n\n` +
                      ` **Registrar compra:**\n"registra: compra de 10 zapatos por 550000"\n\n` +
                      ` **Registrar venta:**\n"venta: 3 camisas a 60 mil"\n\n` +
                      ` **Ver informe:**\n"informe" o "presenta: informe"`
        });
        
    } catch (error) {
        logger.error('Error en ejecutarComandoBasico:', error);
        res.status(500).json({ error: error.message });
    }
});

export const registrarAmortizacion = onCall(async (data, context) => {
    if (!context.auth) {
        throw new Error('Usuario no autenticado');
    }
    
    const { concepto, valorTotal, vidaUtilMeses, userId } = data;
    
    if (!concepto || !valorTotal || !vidaUtilMeses || !userId) {
        throw new Error('Faltan datos: concepto, valorTotal, vidaUtilMeses, userId');
    }
    
    const mensual = valorTotal / vidaUtilMeses;
    
    await db.collection('amortizaciones').add({
        userId,
        concepto,
        valorTotal: parseFloat(valorTotal),
        vidaUtilMeses: parseInt(vidaUtilMeses),
        amortizacionMensual: Math.round(mensual * 100) / 100,
        mesesRestantes: parseInt(vidaUtilMeses),
        activo: true,
        fechaInicio: new Date().toISOString(),
        creadoEn: new Date().toISOString()
    });
    
    return { 
        success: true, 
        mensaje: `Amortización registrada: ${concepto} - $${mensual.toFixed(2)}/mes por ${vidaUtilMeses} meses` 
    };
});

