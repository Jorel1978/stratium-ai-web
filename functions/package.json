    "@google/generative-ai": "^0.24.1",
    "csv-parse": "^6.2.1",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^9.6.0",
    "google-spreadsheet": "^4.1.1",
    "pdfkit": "^0.15.0",
    "xml2js": "^0.6.2"
  },
  "private": true
}
